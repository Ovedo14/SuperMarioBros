VisualElement {
}

.buttons {
    justify-content: space-evenly;
    align-self: center;
    align-content: center;
    align-items: auto;
    width: auto;
}

.button {
    width: 200%;
    align-content: auto;
    align-items: center;
    align-self: center;
    height: 11%;
    background-image: url("project://database/Assets/Tiny%20Swords/UI%20Elements/Ribbons/SmallRibbons%205.png?fileID=2800000&guid=39dc09cd13fcd4778a79c980d379cc7b&type=3#SmallRibbons 5");
    background-size: 100% 100%;
    -unity-background-scale-mode: stretch-to-fill;
    background-position-y: center;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    background-color: rgba(0, 0, 0, 0);
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    font-size: 76px;
}

.button:hover {
    scale: 1.2 1.2 1.5;
    transition-duration: 0.5s;
}

.backgroud {
    position: absolute;
    top: 10%;
    left: 10%;
    right: 10%;
    bottom: 10%;
}
